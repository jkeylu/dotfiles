DOTENV_ASSIGNMENTS=()
PARSED_ENV_VALUE=""

parse_env_value() {
  local raw_value
  local single_quote_pattern="^'([^']*)'[[:space:]]*(#.*)?$"
  local double_quote_pattern='^"(.*)"[[:space:]]*(#.*)?$'
  local comment_pattern='^(.*[^[:space:]])[[:space:]]+#.*$'

  raw_value="$(trim "$1")"
  if [[ -z "$raw_value" ]]; then
    PARSED_ENV_VALUE=""
  elif [[ "$raw_value" == \'* ]]; then
    [[ "$raw_value" =~ $single_quote_pattern ]] || return 1
    PARSED_ENV_VALUE="${BASH_REMATCH[1]}"
  elif [[ "$raw_value" == \"* ]]; then
    [[ "$raw_value" =~ $double_quote_pattern ]] || return 1
    PARSED_ENV_VALUE="${BASH_REMATCH[1]}"
  elif [[ "$raw_value" == \#* ]]; then
    PARSED_ENV_VALUE=""
  elif [[ "$raw_value" =~ $comment_pattern ]]; then
    PARSED_ENV_VALUE="$(trim "${BASH_REMATCH[1]}")"
  else
    PARSED_ENV_VALUE="$raw_value"
  fi
}

load_env_file() {
  local raw_line
  local line
  local key
  local raw_value
  local line_number=0
  local loaded_count=0
  local skipped_count=0
  local -a env_keys=()
  local -A env_values=()

  DOTENV_ASSIGNMENTS=()
  if [[ ! -f "$ENV_FILE_VALUE" ]]; then
    log "环境变量文件不存在，跳过：$ENV_FILE_VALUE"
    return 0
  fi

  while IFS= read -r raw_line || [[ -n "$raw_line" ]]; do
    ((line_number += 1))
    raw_line="${raw_line%$'\r'}"
    if (( line_number == 1 )); then
      raw_line="${raw_line#$'\xEF\xBB\xBF'}"
    fi
    line="$(trim "$raw_line")"
    [[ -n "$line" ]] || continue
    [[ "$line" != \#* ]] || continue

    if [[ "$line" == export[[:space:]]* ]]; then
      line="$(trim "${line#export}")"
    fi
    if [[ "$line" != *=* ]]; then
      log "环境变量文件错误：${ENV_FILE_VALUE}:${line_number}，应使用 KEY=VALUE。"
      return 1
    fi

    key="$(trim "${line%%=*}")"
    raw_value="${line#*=}"
    if [[ ! "$key" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]]; then
      log "环境变量文件错误：${ENV_FILE_VALUE}:${line_number}，变量名无效。"
      return 1
    fi
    if ! parse_env_value "$raw_value"; then
      log "环境变量文件错误：${ENV_FILE_VALUE}:${line_number}，引号不完整。"
      return 1
    fi

    if [[ -z "${env_values[$key]+存在}" ]]; then
      env_keys+=("$key")
    fi
    env_values["$key"]="$PARSED_ENV_VALUE"
  done <"$ENV_FILE_VALUE"

  for key in "${env_keys[@]}"; do
    if printenv "$key" >/dev/null 2>&1; then
      ((skipped_count += 1))
      continue
    fi
    DOTENV_ASSIGNMENTS+=("${key}=${env_values[$key]}")
    ((loaded_count += 1))
  done

  log "读取环境变量文件：$ENV_FILE_VALUE；加载 ${loaded_count} 项，保留已有变量 ${skipped_count} 项。"
}

fingerprint_watched_files() {
  (
    cd "$PROJECT_DIR" || exit 1

    local source_dir
    for source_dir in src/main/java src/main/kotlin src/main/groovy; do
      if [[ -d "$source_dir" ]]; then
        find "$source_dir" -type f -printf '%T@|%s|%p\0'
      fi
    done
    if [[ -d src/main/resources ]]; then
      find src/main/resources -type f -printf '%T@|%s|%p\0'
    fi
    local -a build_files=()
    if [[ "$BUILD_TOOL" == maven ]]; then
      build_files=(pom.xml .mvn/maven.config .mvn/jvm.config)
    else
      build_files=(build.gradle build.gradle.kts settings.gradle settings.gradle.kts gradle.properties gradle/libs.versions.toml gradle/wrapper/gradle-wrapper.properties)
    fi
    for config_file in "${build_files[@]}"; do
      if [[ -f "$config_file" ]]; then
        find "$config_file" -maxdepth 0 -type f -printf '%T@|%s|%p\0'
      fi
    done
    if [[ -f "$ENV_FILE_VALUE" ]]; then
      find "$ENV_FILE_VALUE" -maxdepth 0 -type f -printf '%T@|%s|%p\0'
    fi

    local extra_path
    local normalized_extra_path
    for extra_path in "${WATCH_EXTRA_PATHS[@]}"; do
      normalized_extra_path="$(to_bash_path "$extra_path")"
      if [[ "$normalized_extra_path" != /* ]]; then
        normalized_extra_path="${PROJECT_DIR}/${normalized_extra_path}"
      fi
      if [[ -d "$normalized_extra_path" ]]; then
        find "$normalized_extra_path" -type f -printf '%T@|%s|%p\0'
      elif [[ -f "$normalized_extra_path" ]]; then
        find "$normalized_extra_path" -maxdepth 0 -type f -printf '%T@|%s|%p\0'
      fi
    done
  ) | LC_ALL=C sort -z | sha256sum | awk '{print $1}'
}

build_project() {
  log "开始构建；构建成功前旧服务保持运行。"
  (
    cd "$PROJECT_DIR" || exit 1
    "${BUILD_COMMAND[@]}" "${BUILD_ARGS[@]}"
  )
}

resolve_jar_file() {
  local candidate
  local candidate_mtime
  local latest_path=""
  local latest_mtime=0

  if [[ -n "$JAR_FILE_VALUE" ]]; then
    [[ -f "$JAR_FILE_VALUE" ]] || return 1
    printf '%s' "$JAR_FILE_VALUE"
    return 0
  fi

  [[ -d "$BUILD_OUTPUT_DIR" ]] || return 1
  while IFS= read -r -d '' candidate; do
    candidate_mtime="$(stat -c '%Y' "$candidate" 2>/dev/null || printf '0')"
    if (( candidate_mtime >= latest_mtime )); then
      latest_mtime="$candidate_mtime"
      latest_path="$candidate"
    fi
  done < <(
    find "$BUILD_OUTPUT_DIR" -maxdepth 1 -type f -name '*.jar' \
      ! -name 'original-*.jar' \
      ! -name '*-sources.jar' \
      ! -name '*-javadoc.jar' \
      ! -name '*-tests.jar' \
      ! -name '*-plain.jar' \
      -print0
  )

  [[ -n "$latest_path" ]] || return 1
  printf '%s' "$latest_path"
}

SERVICE_PID=""
CURRENT_RUN_JAR=""
PREVIOUS_RUN_JAR=""
SHUTDOWN_STARTED=0

prepare_run_jar() {
  local built_jar="$1"
  local generation
  local next_run_jar

  mkdir -p "$RUN_DIR" || return 1
  generation="$(date '+%Y%m%d-%H%M%S')-${BASHPID}-${RANDOM}"
  next_run_jar="${RUN_DIR}/application-${generation}.jar"
  cp "$built_jar" "$next_run_jar" || return 1
  printf '%s' "$next_run_jar"
}

stop_service() {
  local waited=0
  local wait_limit=$((STOP_TIMEOUT_SECONDS * 10))
  local exit_code=0

  if [[ -z "$SERVICE_PID" ]]; then
    return 0
  fi

  if kill -0 "$SERVICE_PID" 2>/dev/null; then
    log "停止服务，进程号：$SERVICE_PID"
    kill -TERM "$SERVICE_PID" 2>/dev/null || true
    while kill -0 "$SERVICE_PID" 2>/dev/null && (( waited < wait_limit )); do
      sleep 0.1
      ((waited += 1))
    done
    if kill -0 "$SERVICE_PID" 2>/dev/null; then
      log "正常停止超时，强制结束进程：$SERVICE_PID"
      kill -KILL "$SERVICE_PID" 2>/dev/null || true
    fi
  fi

  wait "$SERVICE_PID" 2>/dev/null || exit_code=$?
  SERVICE_PID=""
  return "$exit_code"
}

start_service() {
  local run_jar="$1"

  PREVIOUS_RUN_JAR="$CURRENT_RUN_JAR"
  CURRENT_RUN_JAR="$run_jar"

  log "启动服务，Spring Boot 环境：${SPRING_PROFILES_ACTIVE}"
  env "${DOTENV_ASSIGNMENTS[@]}" "$JAVA_CMD" "${JAVA_OPTS[@]}" -jar "$CURRENT_RUN_JAR" "${APPLICATION_ARGS[@]}" </dev/null &
  SERVICE_PID=$!
  log "服务进程号：$SERVICE_PID"

  if [[ -n "$PREVIOUS_RUN_JAR" && "$PREVIOUS_RUN_JAR" != "$CURRENT_RUN_JAR" ]]; then
    rm -f -- "$PREVIOUS_RUN_JAR" 2>/dev/null || true
    PREVIOUS_RUN_JAR=""
  fi
}

confirm_restart() {
  local answer

  [[ "$RESTART_MODE" == "ask" ]] || return 0
  if [[ ! -t 0 || ! -r /dev/tty || ! -w /dev/tty ]]; then
    log "当前不是交互终端，已跳过重启；无人值守时请使用 restart_mode=auto。"
    return 1
  fi

  while true; do
    printf '检测到项目修改，是否重新构建并重启？[y/N/a/q] ' >/dev/tty
    if ! IFS= read -r answer </dev/tty; then
      printf '\n' >/dev/tty
      log "无法读取确认输入，已跳过重启。"
      return 1
    fi
    case "${answer,,}" in
      y|yes) return 0 ;;
      ""|n|no) return 1 ;;
      a)
        RESTART_MODE="auto"
        log "本次会话后续修改将自动重启。"
        return 0
        ;;
      q)
        log "用户请求退出。"
        exit 0
        ;;
      *) printf '请输入 y、N、a 或 q。\n' >/dev/tty ;;
    esac
  done
}

cleanup() {
  local ignored_exit_code=0
  if (( SHUTDOWN_STARTED )); then
    return
  fi
  SHUTDOWN_STARTED=1

  stop_service || ignored_exit_code=$?
  if [[ -n "$CURRENT_RUN_JAR" ]]; then
    rm -f -- "$CURRENT_RUN_JAR" 2>/dev/null || true
  fi
  if [[ -n "$PREVIOUS_RUN_JAR" ]]; then
    rm -f -- "$PREVIOUS_RUN_JAR" 2>/dev/null || true
  fi
  rmdir "$RUN_DIR" 2>/dev/null || true
}

handle_signal() {
  printf '\n'
  log "收到退出请求。"
  cleanup
  exit 130
}

trap handle_signal INT TERM
trap cleanup EXIT

log "项目目录：$PROJECT_DIR"
log "Java：$JAVA_CMD"
log "构建工具：$BUILD_TOOL (${BUILD_COMMAND[*]})"
log "Spring Boot 环境：$SPRING_PROFILES_ACTIVE"
log "环境变量文件：$ENV_FILE_VALUE"
log "重启方式：$RESTART_MODE；防抖：${RESTART_DELAY_SECONDS} 秒；扫描：${POLL_INTERVAL_SECONDS} 秒"
log "监听源码、资源、${BUILD_TOOL} 配置和 ${#WATCH_EXTRA_PATHS[@]} 个额外路径。"

INITIAL_FINGERPRINT="$(fingerprint_watched_files)" || die "无法扫描监听文件。"

if (( ! SKIP_INITIAL_BUILD )); then
  build_project || die "首次 ${BUILD_TOOL} 构建失败。"
fi

load_env_file || die "应用环境变量加载失败。"
BUILT_JAR="$(resolve_jar_file)" || die "未找到可执行 JAR，请先构建或使用 --jar。"
NEXT_RUN_JAR="$(prepare_run_jar "$BUILT_JAR")" || die "无法准备运行 JAR。"
start_service "$NEXT_RUN_JAR"

OBSERVED_FINGERPRINT="$INITIAL_FINGERPRINT"
PENDING_FINGERPRINT=""
LAST_CHANGE_EPOCH=0

while true; do
  sleep "$POLL_INTERVAL_SECONDS"

  if [[ -n "$SERVICE_PID" ]] && ! kill -0 "$SERVICE_PID" 2>/dev/null; then
    SERVICE_EXIT_CODE=0
    wait "$SERVICE_PID" 2>/dev/null || SERVICE_EXIT_CODE=$?
    log "服务已退出，退出码：$SERVICE_EXIT_CODE；下次修改后将重新启动。"
    SERVICE_PID=""
  fi

  CURRENT_FINGERPRINT="$(fingerprint_watched_files)" || {
    log "警告：文件扫描失败，稍后重试。"
    continue
  }

  if [[ "$CURRENT_FINGERPRINT" == "$OBSERVED_FINGERPRINT" ]]; then
    PENDING_FINGERPRINT=""
    continue
  fi

  NOW_EPOCH="$(date '+%s')"
  if [[ "$CURRENT_FINGERPRINT" != "$PENDING_FINGERPRINT" ]]; then
    PENDING_FINGERPRINT="$CURRENT_FINGERPRINT"
    LAST_CHANGE_EPOCH="$NOW_EPOCH"
    log "检测到修改，等待 ${RESTART_DELAY_SECONDS} 秒。"
  fi

  if (( NOW_EPOCH - LAST_CHANGE_EPOCH < RESTART_DELAY_SECONDS )); then
    continue
  fi

  if ! confirm_restart; then
    OBSERVED_FINGERPRINT="$(fingerprint_watched_files)" || OBSERVED_FINGERPRINT="$CURRENT_FINGERPRINT"
    PENDING_FINGERPRINT=""
    log "已跳过本次重启。"
    continue
  fi

  BUILD_INPUT_FINGERPRINT="$(fingerprint_watched_files)" || BUILD_INPUT_FINGERPRINT="$CURRENT_FINGERPRINT"
  OBSERVED_FINGERPRINT="$BUILD_INPUT_FINGERPRINT"
  PENDING_FINGERPRINT=""

  if ! build_project; then
    log "构建失败，旧服务继续运行；再次保存文件后重试。"
    continue
  fi

  if ! load_env_file; then
    log "应用环境变量加载失败，旧服务继续运行。"
    continue
  fi

  BUILT_JAR="$(resolve_jar_file)" || {
    log "构建成功但未找到可执行 JAR，旧服务继续运行。"
    continue
  }
  NEXT_RUN_JAR="$(prepare_run_jar "$BUILT_JAR")" || {
    log "无法准备新 JAR，旧服务继续运行。"
    continue
  }

  stop_service || true
  start_service "$NEXT_RUN_JAR"
done
