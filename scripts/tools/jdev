major_from_expression() {
  local value="$1"
  [[ "$value" != *'$'* ]] || return 1
  if [[ "$value" =~ VERSION_1_([0-9]+) ]]; then
    printf '%s' "${BASH_REMATCH[1]}"
  elif [[ "$value" =~ VERSION_([0-9]+) ]]; then
    printf '%s' "${BASH_REMATCH[1]}"
  elif [[ "$value" =~ (^|[^0-9])1\.([0-9]+) ]]; then
    printf '%s' "${BASH_REMATCH[2]}"
  elif [[ "$value" =~ (^|[^0-9])([0-9]+) ]]; then
    printf '%s' "${BASH_REMATCH[2]}"
  else
    return 1
  fi
}

xml_tag_value() {
  local xml="$1" tag="$2" pattern
  tag="${tag//./\\.}"
  pattern="<${tag}>[[:space:]]*([^<]+)[[:space:]]*</${tag}>"
  [[ "$xml" =~ $pattern ]] || return 1
  trim "${BASH_REMATCH[1]}"
}

detect_maven_java_version() {
  local xml candidate property major
  xml="$(awk '
    BEGIN { comment = 0 }
    {
      line = $0; output = ""
      while (length(line)) {
        if (comment) {
          finish = index(line, "-->")
          if (!finish) break
          line = substr(line, finish + 3); comment = 0
        } else {
          start = index(line, "<!--")
          if (!start) { output = output line; break }
          output = output substr(line, 1, start - 1)
          line = substr(line, start + 4); comment = 1
        }
      }
      printf "%s ", output
    }
  ' "${PROJECT_DIR}/pom.xml")" || return 1
  for property in maven.compiler.release release java.version maven.compiler.target target maven.compiler.source source; do
    candidate="$(xml_tag_value "$xml" "$property" || true)"
    [[ -n "$candidate" ]] || continue
    if [[ "$candidate" =~ ^\$\{([a-zA-Z0-9_.-]+)\}$ ]]; then
      candidate="$(xml_tag_value "$xml" "${BASH_REMATCH[1]}" || true)"
    fi
    major="$(major_from_expression "$candidate" || true)"
    if [[ -n "$major" ]]; then
      printf '%s' "$major"
      return 0
    fi
  done
  return 1
}

detect_gradle_java_version() {
  local file content pattern candidate major
  for file in "${PROJECT_DIR}/build.gradle" "${PROJECT_DIR}/build.gradle.kts"; do
    [[ -f "$file" ]] || continue
    content="$(awk '
      BEGIN { block = 0 }
      {
        line = $0; output = ""
        while (length(line)) {
          if (block) {
            finish = index(line, "*/")
            if (!finish) break
            line = substr(line, finish + 2); block = 0
          } else {
            start = index(line, "/*"); comment = index(line, "//")
            if (comment && (!start || comment < start)) {
              output = output substr(line, 1, comment - 1); break
            }
            if (!start) { output = output line; break }
            output = output substr(line, 1, start - 1)
            line = substr(line, start + 2); block = 1
          }
        }
        printf "%s ", output
      }
    ' "$file")" || continue
    for pattern in \
      'JavaLanguageVersion[[:space:]]*\.[[:space:]]*of[[:space:]]*\([[:space:]]*([0-9]+)' \
      'jvmToolchain[[:space:]]*\([[:space:]]*([0-9]+)' \
      'targetCompatibility[[:space:]]*=[[:space:]]*([^[:space:];]+)' \
      'sourceCompatibility[[:space:]]*=[[:space:]]*([^[:space:];]+)'; do
      if [[ "$content" =~ $pattern ]]; then
        candidate="${BASH_REMATCH[1]}"
        major="$(major_from_expression "$candidate" || true)"
        if [[ -n "$major" ]]; then
          printf '%s' "$major"
          return 0
        fi
      fi
    done
  done
  return 1
}

JAVA_CMD=""
JAVA_HOME_VALUE=""
select_java_home() {
  local home binary
  home="$(to_bash_path "$1")"
  [[ -d "$home" ]] || return 1
  if ! java_binary_in_home "$home" >/dev/null; then
    home="$(jdk_home_from_directory "$home")" || return 1
  fi
  binary="$(java_binary_in_home "$home")" || return 1
  "$binary" -version >/dev/null 2>&1 || return 1
  JAVA_HOME_VALUE="$(cd "$home" && pwd -P)"
  JAVA_CMD="$binary"
}

select_java_from_path() {
  JAVA_CMD="$(command -v java 2>/dev/null)" || return 1
  [[ -n "$JAVA_CMD" ]] || return 1
  "$JAVA_CMD" -version >/dev/null 2>&1 || return 1
  JAVA_HOME_VALUE=""
}

resolve_java_version() {
  local required_major="$1" version major path_java=""
  if find_jdk_in_root "$required_major"; then
    if select_java_home "$MATCHED_JDK"; then
      return 0
    fi
  fi
  if [[ -n "${JAVA_HOME-}" ]] && select_java_home "$JAVA_HOME"; then
    version="$(java_version_in_home "$JAVA_HOME_VALUE" || true)"
    major="$(normalize_java_major "$version" || true)"
    [[ "$major" != "$required_major" ]] || return 0
  fi
  if select_java_from_path; then
    version="$(java_version_from_command "$JAVA_CMD" || true)"
    major="$(normalize_java_major "$version" || true)"
    [[ "$major" != "$required_major" ]] || return 0
  fi
  die "未找到 Java ${required_major}；JDK_HOME 中发现：${AVAILABLE_JDKS:-无}；JAVA_HOME/PATH 也没有匹配版本。"
}

JAVA_SELECTION_HOME=""
