    CLI) layer_home="$CLI_JAVA_HOME"; layer_version="$CLI_JAVA_VERSION" ;;
    PROJECT) layer_home="${PROJECT_CONFIG[java_home]-}"; layer_version="${PROJECT_CONFIG[java_version]-}" ;;
    GLOBAL) layer_home="${GLOBAL_CONFIG[java_home]-}"; layer_version="${GLOBAL_CONFIG[java_version]-}" ;;
    HEADER) layer_home="$JAVA_HOME_OVERRIDE"; layer_version="$JAVA_VERSION_OVERRIDE" ;;
  esac
  if [[ -n "$layer_home" || -n "$layer_version" ]]; then
    JAVA_SELECTION_HOME="$layer_home"
    JAVA_SELECTION_VERSION="$layer_version"
    break
  fi
done

if [[ -n "$JAVA_SELECTION_VERSION" ]]; then
  JAVA_SELECTION_VERSION="$(normalize_java_major "$JAVA_SELECTION_VERSION")" || die "java_version 必须是 Java 主版本，如 8、17、21。"
