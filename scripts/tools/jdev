generate_config() {
  local config_file="$1"
  local temp_file="${config_file}.tmp.${BASHPID}"
  if [[ -e "$config_file" && "$FORCE_INIT" -ne 1 ]]; then
    die "配置文件已存在：$config_file；如需覆盖请添加 --force。"
  fi
  if ! cat >"$temp_file" <<'EOF'
# 所有设置均为可选项；取消注释后生效。相对路径以本配置文件所在目录为准。
# project_dir=.
# build_tool=maven
# java_home=/path/to/jdk
# java_version=17
# maven_home=/path/to/maven
# gradle_home=/path/to/gradle
# spring_profile=dev
# restart_delay_seconds=3
# poll_interval_seconds=1
# stop_timeout_seconds=10
# restart_mode=auto
# jar_file=target/application.jar
# env_file=.env
# maven_arg=-DskipTests
# maven_arg=package
# gradle_arg=build
# gradle_arg=-x
# gradle_arg=test
# java_opt=-Xmx2g
# app_arg=--server.port=8081
# watch=src/main/kotlin
EOF
  then
    rm -f -- "$temp_file" 2>/dev/null || true
    die "无法写入临时配置：$temp_file"
  fi
  if ! mv -f -- "$temp_file" "$config_file"; then
    rm -f -- "$temp_file" 2>/dev/null || true
    die "无法生成配置：$config_file"
  fi
  log "已生成配置：$config_file"
}

