#!/usr/bin/env bash

# jdev 在 Git Bash 中构建并运行 Spring Boot Maven/Gradle 项目，监听修改后重启。
# 配置文件只在启动时读取；构建失败时保留正在运行的服务。

# ------------------------- 可编辑配置 -------------------------
PROJECT_DIR_OVERRIDE=""               # 项目目录
BUILD_TOOL_OVERRIDE=""                # maven、gradle 或 auto
JAVA_HOME_OVERRIDE=""                 # Java 安装目录
JAVA_VERSION_OVERRIDE=""              # Java 主版本
MAVEN_HOME_OVERRIDE=""                # Maven 安装目录
GRADLE_HOME_OVERRIDE=""               # Gradle 安装目录
SPRING_PROFILE_OVERRIDE=""            # Spring Boot 环境
RESTART_DELAY_SECONDS_OVERRIDE=""      # 重启防抖秒数
POLL_INTERVAL_SECONDS_OVERRIDE=""      # 文件扫描间隔秒数
STOP_TIMEOUT_SECONDS_OVERRIDE=""       # 服务停止超时秒数
RESTART_MODE_OVERRIDE=""               # 重启方式：auto 或 ask
JAR_FILE_OVERRIDE=""                  # 可执行 JAR 路径
ENV_FILE_OVERRIDE=""                  # 应用环境变量文件

# 数组中的每一项都是一个独立参数；留空时读取配置文件或默认值。
MAVEN_BUILD_ARGS_OVERRIDE=()
GRADLE_BUILD_ARGS_OVERRIDE=()
JAVA_OPTS_OVERRIDE=()
APPLICATION_ARGS_OVERRIDE=()
WATCH_EXTRA_PATHS_OVERRIDE=()
# --------------------------------------------------------------

set -uo pipefail

SCRIPT_NAME="$(basename "$0")"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
INVOKE_DIR="$(pwd -P)"
CONFIG_NAME=".jdev.conf"
COMMAND="run"

CLI_PROJECT_DIR=""
CLI_BUILD_TOOL=""
CLI_JAVA_HOME=""
CLI_JAVA_VERSION=""
CLI_MAVEN_HOME=""
CLI_GRADLE_HOME=""
CLI_SPRING_PROFILE=""
CLI_RESTART_DELAY=""
CLI_POLL_INTERVAL=""
CLI_STOP_TIMEOUT=""
CLI_RESTART_MODE=""
CLI_JAR_FILE=""
CLI_ENV_FILE=""
SKIP_INITIAL_BUILD=0
FORCE_INIT=0
GLOBAL_INIT=0
CLI_MAVEN_ARGS=()
CLI_GRADLE_ARGS=()
CLI_JAVA_OPTS=()
CLI_APPLICATION_ARGS=()
CLI_WATCH_PATHS=()

usage() {
  cat <<EOF
用法：
  ${SCRIPT_NAME} [选项] [-- 应用参数]
  ${SCRIPT_NAME} init [--project-dir <目录> | --global] [--force]
  ${SCRIPT_NAME} jdk <ls|ls-remote|install> [版本]

命令：
  init                       生成配置模板
  jdk ls                     列出本地 JDK
  jdk ls-remote              列出远程 LTS 主版本
  jdk install <版本>          安装最新的 Temurin LTS 补丁版本

选项：
  --project-dir <目录>       Spring Boot 项目目录
  --build-tool <工具>        maven 或 gradle；默认自动判断
  --java-home <目录>         指定 JDK 目录
  --java-version <版本>      指定 Java 主版本，如 8、17、21
  --maven-home <目录>        指定 Maven 安装目录
  --gradle-home <目录>       指定 Gradle 安装目录
  --profile <名称>           Spring Boot 环境，默认 dev
  --delay <秒>               修改稳定后的等待时间，默认 3
  --poll <秒>                文件扫描间隔，默认 1
  --stop-timeout <秒>        服务停止超时，默认 10
  --restart-mode <方式>      auto 自动重启，ask 重启前询问
  --jar <路径>               指定可执行 JAR
  --env-file <路径>          应用环境变量文件，默认 .env
  --skip-initial-build       使用已有 JAR 启动
  --maven-arg <参数>         设置 Maven 构建参数，可重复
  --gradle-arg <参数>        设置 Gradle 构建参数，可重复
  --java-opt <参数>          设置 JVM 参数，可重复
  --app-arg <参数>           设置应用参数，可重复
  --watch <路径>             设置额外监听路径，可重复
  --global                   init 时在 HOME 目录生成配置
  --force                    init 时覆盖已有配置
  -h, --help                 显示帮助

配置查找：
  从 HOME 读取全局配置，从项目读取项目配置；当前目录向上查找项目。
  如果当前目录不在项目中，最后尝试脚本所在目录。

配置优先级：
  命令行 > 项目配置 > HOME 配置 > 脚本头部覆盖值 > 环境变量 > 默认值

环境变量：
  JAVA_HOME、JDK_HOME（默认 HOME/.jdks）、MAVEN_HOME、GRADLE_HOME、SPRING_BOOT_PROJECT_DIR
  SPRING_PROFILES_ACTIVE、SPRING_BOOT_BUILD_TOOL
  SPRING_BOOT_RESTART_DELAY_SECONDS、SPRING_BOOT_POLL_INTERVAL_SECONDS
  SPRING_BOOT_STOP_TIMEOUT_SECONDS、SPRING_BOOT_RESTART_MODE、SPRING_BOOT_JAR_FILE
  SPRING_BOOT_ENV_FILE

默认监听：
  Java/Kotlin/Groovy 源码、资源、所选构建工具的配置和应用环境变量文件

示例：
  ${SCRIPT_NAME} init
  ${SCRIPT_NAME} init --global
  ${SCRIPT_NAME} jdk ls-remote
  ${SCRIPT_NAME} jdk install 21
  ${SCRIPT_NAME}
  ${SCRIPT_NAME} --delay 5 --profile dev
  ${SCRIPT_NAME} --restart-mode ask
  ${SCRIPT_NAME} --env-file .env.dev
  ${SCRIPT_NAME} --project-dir D:/code/order-service
  ${SCRIPT_NAME} --java-opt=-Xmx2g -- --server.port=8081
EOF
}

die() {
  printf '[jdev] 错误：%s\n' "$*" >&2
  exit 1
}

log() {
  printf '[jdev] %s %s\n' "$(date '+%H:%M:%S')" "$*"
}

need_value() {
  [[ $# -ge 2 && -n "$2" ]] || die "选项 $1 缺少参数。"
}

first_non_empty() {
  local value
  for value in "$@"; do
    if [[ -n "$value" ]]; then
      printf '%s' "$value"
      return 0
    fi
  done
  return 1
}

trim() {
  local value="$1"
  value="${value#"${value%%[![:space:]]*}"}"
  value="${value%"${value##*[![:space:]]}"}"
  printf '%s' "$value"
}

to_bash_path() {
  local path_value="$1"
  if command -v cygpath >/dev/null 2>&1; then
    cygpath -u "$path_value" 2>/dev/null || printf '%s' "$path_value"
  else
    printf '%s' "$path_value"
  fi
}

absolute_from_base() {
  local path_value
  local base_dir="$2"
  path_value="$(to_bash_path "$1")"
  if [[ "$path_value" == /* ]]; then
    printf '%s' "$path_value"
  else
    printf '%s/%s' "${base_dir%/}" "$path_value"
  fi
}

# ------------------------- JDK 命令与发现 -------------------------

jdk_root() {
  local root="${JDK_HOME-}" home
  if [[ -z "$root" ]]; then
    [[ -n "${HOME-}" ]] || return 1
    home="$(to_bash_path "$HOME")"
    root="${home%/}/.jdks"
  fi
  absolute_from_base "$root" "$INVOKE_DIR"
}

jdk_home_from_directory() {
  local directory="$1"
  if java_binary_in_home "$directory" >/dev/null; then
    printf '%s' "$directory"
  elif java_binary_in_home "$directory/Contents/Home" >/dev/null; then
    printf '%s/Contents/Home' "$directory"
  else
    return 1
  fi
}

java_binary_in_home() {
  local bin="${1%/}/bin/java"
  if [[ -f "$bin" ]]; then
    printf '%s' "$bin"
  elif [[ -f "${bin}.exe" ]]; then
    printf '%s' "${bin}.exe"
  else
    return 1
  fi
}

normalize_java_major() {
  local value="$1"
  if [[ "$value" =~ ^1\.([0-9]+)([._+~-].*)?$ ]]; then
    printf '%s' "${BASH_REMATCH[1]}"
  elif [[ "$value" =~ ^([0-9]+)([._+~-].*)?$ ]]; then
    printf '%s' "${BASH_REMATCH[1]}"
  else
    return 1
  fi
}

java_version_from_command() {
  local output
  output="$("$1" -version 2>&1)" || return 1
  if [[ "$output" =~ \"([0-9][^\"]*)\" ]]; then
    printf '%s' "${BASH_REMATCH[1]}"
  elif [[ "$output" =~ version[[:space:]]+([0-9][^[:space:]]*) ]]; then
    printf '%s' "${BASH_REMATCH[1]}"
  else
    return 1
  fi
}

java_version_in_home() {
  local home="$1" line binary
  if [[ -f "${home%/}/release" ]]; then
    while IFS= read -r line; do
      line="${line%$'\r'}"
      if [[ "$line" =~ ^JAVA_VERSION=\"?([^\"]+)\"?$ ]]; then
        printf '%s' "${BASH_REMATCH[1]}"
        return 0
      fi
    done <"${home%/}/release"
  fi
  binary="$(java_binary_in_home "$home")" || return 1
  java_version_from_command "$binary"
}

jdk_valid_home() {
  local binary version major binary_version binary_major
  binary="$(java_binary_in_home "$1")" || return 1
  binary_version="$(java_version_from_command "$binary")" || return 1
  binary_major="$(normalize_java_major "$binary_version")" || return 1
  version="$(java_version_in_home "$1")" || return 1
  major="$(normalize_java_major "$version")" || return 1
  [[ "$major" == "$binary_major" ]]
}

jdk_version_numbers() {
  local rest="$1" number
  JDK_VERSION_PARTS=()
  [[ "$rest" != 1.* ]] || rest="${rest#1.}"
  while [[ "$rest" =~ ([0-9]+) ]]; do
    number="${BASH_REMATCH[1]}"
    JDK_VERSION_PARTS+=("$((10#$number))")
    rest="${rest#*${number}}"
  done
}

version_is_newer() {
  local candidate="$1" previous="$2" index left right
  local -a candidate_parts=() previous_parts=()
  [[ -n "$previous" ]] || return 0
  jdk_version_numbers "$candidate"
  candidate_parts=("${JDK_VERSION_PARTS[@]}")
  jdk_version_numbers "$previous"
  previous_parts=("${JDK_VERSION_PARTS[@]}")
  for ((index = 0; index < ${#candidate_parts[@]} || index < ${#previous_parts[@]}; index++)); do
    left="${candidate_parts[index]:-0}"
    right="${previous_parts[index]:-0}"
    if (( left > right )); then return 0; fi
    if (( left < right )); then return 1; fi
  done
  return 0
}

MATCHED_JDK=""
AVAILABLE_JDKS=""
find_jdk_in_root() {
  local required_major="$1" root child home version major best_version=""
  MATCHED_JDK=""
  AVAILABLE_JDKS=""
  root="$(jdk_root)" || return 1
  [[ -d "$root" ]] || return 1
  for child in "$root"/*; do
    [[ -d "$child" ]] || continue
    home="$(jdk_home_from_directory "$child" || true)"
    [[ -n "$home" ]] || continue
    jdk_valid_home "$home" || continue
    version="$(java_version_in_home "$home" || true)"
    major="$(normalize_java_major "$version" || true)"
    [[ -n "$major" ]] || continue
    AVAILABLE_JDKS="${AVAILABLE_JDKS:+${AVAILABLE_JDKS}, }${version} (${home})"
    [[ -z "$required_major" || "$major" == "$required_major" ]] || continue
    if version_is_newer "$version" "$best_version"; then
      best_version="$version"
      MATCHED_JDK="$home"
    fi
  done
  [[ -n "$MATCHED_JDK" ]]
}

jdk_ls() {
  local root child home version major index temp
  local -a versions=() homes=()
  root="$(jdk_root)" || die "未设置 HOME 或 JDK_HOME。"
  [[ -d "$root" ]] || return 0
  for child in "$root"/*; do
    [[ -d "$child" ]] || continue
    home="$(jdk_home_from_directory "$child" || true)"
    [[ -n "$home" ]] || continue
    jdk_valid_home "$home" || continue
    version="$(java_version_in_home "$home" || true)"
    major="$(normalize_java_major "$version" || true)"
    [[ -n "$major" ]] || continue
    versions+=("$version")
    homes+=("$home")
    for ((index = ${#versions[@]} - 1; index > 0; index--)); do
      version_is_newer "${versions[index]}" "${versions[index-1]}" || break
      temp="${versions[index-1]}"
      versions[index-1]="${versions[index]}"
      versions[index]="$temp"
      temp="${homes[index-1]}"
      homes[index-1]="${homes[index]}"
      homes[index]="$temp"
    done
  done
  for index in "${!versions[@]}"; do
    printf '%s\t%s\n' "${versions[index]}" "${homes[index]}"
  done
}

jdk_remote_lts() {
  local response pattern versions value
  command -v curl >/dev/null 2>&1 || die "远程 JDK 命令需要 curl。"
  response="$(curl --fail --silent --show-error --location --connect-timeout 15 --retry 2 \
    'https://api.adoptium.net/v3/info/available_releases')" || die "无法读取 Adoptium LTS 版本列表。"
  pattern='"available_lts_releases"[[:space:]]*:[[:space:]]*\[([^]]+)\]'
  [[ "$response" =~ $pattern ]] || die "Adoptium 返回的 LTS 版本列表格式无效。"
  versions="${BASH_REMATCH[1]}"
  versions="${versions//[[:space:]]/}"
  [[ "$versions" =~ ^[0-9]+(,[0-9]+)*$ ]] || die "Adoptium 返回的 LTS 版本列表格式无效。"
  local -a items=()
  IFS=, read -r -a items <<< "$versions"
  for value in "${items[@]}"; do
    printf '%s\n' "$value"
  done
}

jdk_platform() {
  local system machine
  system="$(uname -s)" || die "无法识别操作系统。"
  machine="$(uname -m)" || die "无法识别处理器架构。"
  case "$system" in
    MINGW*|MSYS*|CYGWIN*) JDK_API_OS=windows; JDK_ARCHIVE_TYPE=zip ;;
    Linux*) JDK_API_OS=linux; JDK_ARCHIVE_TYPE=tar.gz ;;
    Darwin*) JDK_API_OS=mac; JDK_ARCHIVE_TYPE=tar.gz ;;
    *) die "不支持的操作系统：$system" ;;
  esac
  case "$machine" in
    x86_64|amd64) JDK_API_ARCH=x64 ;;
    i386|i486|i586|i686|x86) JDK_API_ARCH=x86 ;;
    aarch64|arm64) JDK_API_ARCH=aarch64 ;;
    armv7l|armv6l) JDK_API_ARCH=arm ;;
    ppc64le|s390x|riscv64) JDK_API_ARCH="$machine" ;;
    *) die "不支持的处理器架构：$machine" ;;
  esac
}

jdk_sha256() {
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum "$1" | awk '{ print $1 }'
  elif command -v shasum >/dev/null 2>&1; then
    shasum -a 256 "$1" | awk '{ print $1 }'
  else
    die "校验下载文件需要 sha256sum 或 shasum。"
  fi
}

jdk_archive_root() {
  local archive="$1" type="$2" entries entry first root=""
  if [[ "$type" == zip ]]; then
    entries="$(unzip -Z1 "$archive")" || return 1
  else
    entries="$(tar -tzf "$archive")" || return 1
  fi
  while IFS= read -r entry || [[ -n "$entry" ]]; do
    entry="${entry#./}"
    [[ -n "$entry" ]] || continue
    [[ "$entry" != /* && "$entry" != *\\* ]] || return 1
    case "/$entry/" in */../*|*/./*) return 1 ;; esac
    first="${entry%%/*}"
    [[ "$first" != . && "$first" != .. && "$first" =~ ^[A-Za-z0-9._+~-]+$ ]] || return 1
    if [[ -z "$root" ]]; then
      root="$first"
    elif [[ "$root" != "$first" ]]; then
      return 1
    fi
  done <<< "$entries"
  [[ -n "$root" ]] || return 1
  printf '%s' "$root"
}

JDK_INSTALL_STAGE=""
JDK_INSTALL_ROOT=""
jdk_cleanup_install() {
  [[ -n "$JDK_INSTALL_STAGE" && -n "$JDK_INSTALL_ROOT" ]] || return 0
  case "$JDK_INSTALL_STAGE" in
    "$JDK_INSTALL_ROOT"/.jdev-install.*)
      [[ ! -L "$JDK_INSTALL_STAGE" ]] || return 1
      rm -rf "$JDK_INSTALL_STAGE"
      ;;
  esac
}

jdk_install() {
  local requested="$1" released version root stage archive api final_url checksum_url
  local expected actual archive_root extracted home binary binary_version installed_major destination existing_home existing_version
  [[ "$requested" =~ ^[1-9][0-9]*$ ]] || die "请指定 LTS 主版本号，例如：jdev jdk install 17。"
  released="$(jdk_remote_lts)" || return 1
  [[ $'\n'"$released"$'\n' == *$'\n'"$requested"$'\n'* ]] || die "Java ${requested} 不在远程 LTS 列表中。"
  jdk_platform
  command -v awk >/dev/null 2>&1 || die "安装 JDK 需要 awk。"
  command -v mktemp >/dev/null 2>&1 || die "安装 JDK 需要 mktemp。"
  if [[ "$JDK_ARCHIVE_TYPE" == zip ]]; then
    command -v unzip >/dev/null 2>&1 || die "Windows JDK 安装需要 unzip。"
  else
    command -v tar >/dev/null 2>&1 || die "JDK 安装需要 tar。"
  fi
  if ! command -v sha256sum >/dev/null 2>&1 && ! command -v shasum >/dev/null 2>&1; then
    die "校验下载文件需要 sha256sum 或 shasum。"
  fi
  root="$(jdk_root)" || die "未设置 HOME 或 JDK_HOME。"
  mkdir -p "$root" || die "无法创建 JDK 目录：$root"
  root="$(cd "$root" && pwd -P)" || die "无法进入 JDK 目录：$root"
  stage="$(mktemp -d "${root}/.jdev-install.XXXXXX")" || die "无法创建下载临时目录。"
  JDK_INSTALL_ROOT="$root"
  JDK_INSTALL_STAGE="$stage"
  trap jdk_cleanup_install EXIT
  trap 'exit 130' INT TERM

  api="https://api.adoptium.net/v3/binary/latest/${requested}/ga/${JDK_API_OS}/${JDK_API_ARCH}/jdk/hotspot/normal/eclipse"
  archive="${stage}/jdk.${JDK_ARCHIVE_TYPE}"
  log "下载 Eclipse Temurin ${requested} (${JDK_API_OS}/${JDK_API_ARCH})。"
  final_url="$(curl --fail --silent --show-error --location --connect-timeout 15 --retry 2 \
    --output "$archive" --write-out '%{url_effective}' "$api")" || die "下载失败；当前平台可能没有 Java ${requested} 的 JDK 包。"
  [[ "$final_url" == https://* ]] || die "下载地址不是 HTTPS。"
  checksum_url="${final_url%%\?*}.sha256.txt"
  curl --fail --silent --show-error --location --connect-timeout 15 --retry 2 \
    --output "${stage}/checksum" "$checksum_url" || die "无法下载 SHA-256 校验文件。"
  expected="$(awk 'NR == 1 { print $1 }' "${stage}/checksum")"
  [[ "$expected" =~ ^[A-Fa-f0-9]{64}$ ]] || die "SHA-256 校验文件格式无效。"
  actual="$(jdk_sha256 "$archive")" || die "无法计算下载文件的 SHA-256。"
  expected="$(printf '%s' "$expected" | tr 'A-F' 'a-f')"
  actual="$(printf '%s' "$actual" | tr 'A-F' 'a-f')"
  [[ "$expected" == "$actual" ]] || die "JDK 归档文件的 SHA-256 校验失败。"

  archive_root="$(jdk_archive_root "$archive" "$JDK_ARCHIVE_TYPE")" || die "JDK 归档目录结构不安全或无效。"
  mkdir -p "${stage}/extract" || die "无法创建解压目录。"
  if [[ "$JDK_ARCHIVE_TYPE" == zip ]]; then
    unzip -q "$archive" -d "${stage}/extract" || die "解压 JDK ZIP 失败。"
  else
    tar -xzf "$archive" -C "${stage}/extract" || die "解压 JDK tar.gz 失败。"
  fi
  extracted="${stage}/extract/${archive_root}"
  home="$(jdk_home_from_directory "$extracted")" || die "归档中没有 JDK 的 bin/java。"
  binary="$(java_binary_in_home "$home")" || die "归档中没有 Java 可执行文件。"
  binary_version="$(java_version_from_command "$binary")" || die "归档中的 Java 无法运行或版本未知。"
  version="$(java_version_in_home "$home")" || die "无法读取 JDK 版本。"
  installed_major="$(normalize_java_major "$binary_version")" || die "归档中的 JDK 版本无效。"
  [[ "$installed_major" == "$requested" ]] || die "下载的 JDK 为 Java ${installed_major}，与请求的 ${requested} 不一致。"
  [[ "${binary_version%%+*}" == "${version%%+*}" ]] || die "归档中的 Java 与 release 文件版本不一致。"

  destination="${root}/temurin-${archive_root}"
  if [[ -e "$destination" || -L "$destination" ]]; then
    existing_home="$(jdk_home_from_directory "$destination" || true)"
    existing_version=""
    if [[ -n "$existing_home" ]] && jdk_valid_home "$existing_home"; then
      existing_version="$(java_version_in_home "$existing_home" || true)"
    fi
    if [[ -n "$existing_version" && "$existing_version" == "$version" ]]; then
      log "已安装 Eclipse Temurin ${version}：$existing_home"
      return 0
    fi
    die "目标目录已存在且不是同一完整版本，未覆盖：$destination"
  fi
  mv -n "$extracted" "$destination" || die "无法安装 JDK 到：$destination"
  [[ ! -e "$extracted" ]] || die "安装目标目录同时出现，未覆盖：$destination"
  home="$(jdk_home_from_directory "$destination")" || die "安装后的 JDK 路径无效。"
  log "已安装 Eclipse Temurin ${version}：$home"
}

jdk_usage() {
  cat <<EOF
用法：
  ${SCRIPT_NAME} jdk ls
  ${SCRIPT_NAME} jdk ls-remote
  ${SCRIPT_NAME} jdk install <LTS 主版本>

JDK 目录：JDK_HOME；未设置时使用 HOME/.jdks。
EOF
}

jdk_main() {
  local action="${1-}"
  case "$action" in
    ls)
      [[ $# -eq 1 ]] || die "jdk ls 不接受其他参数。"
      jdk_ls
      ;;
    ls-remote)
      [[ $# -eq 1 ]] || die "jdk ls-remote 不接受其他参数。"
      jdk_remote_lts
      ;;
    install)
      [[ $# -eq 2 ]] || die "用法：${SCRIPT_NAME} jdk install <LTS 主版本>"
      jdk_install "$2"
      ;;
    -h|--help|help)
      [[ $# -eq 1 ]] || die "jdk help 不接受其他参数。"
      jdk_usage
      ;;
    *) jdk_usage >&2; die "未知 jdk 命令：${action:-空}" ;;
  esac
}

if [[ "${1-}" == jdk ]]; then
  shift
  jdk_main "$@"
  exit $?
fi

find_upward() {
  local start_dir
  local file_name="$2"
  local parent_dir

  start_dir="$(absolute_from_base "$1" "$INVOKE_DIR")"
  [[ -d "$start_dir" ]] || return 1
  start_dir="$(cd "$start_dir" && pwd -P)" || return 1

  while true; do
    if [[ -f "${start_dir}/${file_name}" ]]; then
      printf '%s/%s' "$start_dir" "$file_name"
      return 0
    fi
    parent_dir="$(dirname "$start_dir")"
    [[ "$parent_dir" != "$start_dir" ]] || break
    start_dir="$parent_dir"
  done
  return 1
}

find_project_upward() {
  local current parent
  current="$(absolute_from_base "$1" "$INVOKE_DIR")"
  [[ -d "$current" ]] || return 1
  current="$(cd "$current" && pwd -P)" || return 1
  while true; do
    if has_maven_project "$current" || has_gradle_project "$current"; then
      printf '%s' "$current"
      return 0
    fi
    parent="$(dirname "$current")"
    [[ "$parent" != "$current" ]] || break
    current="$parent"
  done
  return 1
}

has_maven_project() { [[ -f "$1/pom.xml" ]]; }
has_gradle_project() { [[ -f "$1/build.gradle" || -f "$1/build.gradle.kts" ]]; }

