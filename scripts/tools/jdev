read_config() {
  local config_file="$1" layer="$2"
  local base_dir raw_line line key value line_number=0
  local -n values="${layer}_CONFIG"
  local -n array_set="${layer}_ARRAY_SET"
  local -n maven_args="${layer}_MAVEN_ARGS"
  local -n gradle_args="${layer}_GRADLE_ARGS"
  local -n java_opts="${layer}_JAVA_OPTS"
  local -n application_args="${layer}_APPLICATION_ARGS"
  local -n watch_paths="${layer}_WATCH_PATHS"
  base_dir="$(cd "$(dirname "$config_file")" && pwd -P)" || die "无法进入配置目录：$config_file"
  while IFS= read -r raw_line || [[ -n "$raw_line" ]]; do
    ((line_number += 1))
    raw_line="${raw_line%$'\r'}"
    (( line_number != 1 )) || raw_line="${raw_line#$'\xEF\xBB\xBF'}"
    line="$(trim "$raw_line")"
    [[ -n "$line" && "$line" != \#* ]] || continue
    [[ "$line" == *=* ]] || die "配置错误：${config_file}:${line_number}，应使用 key=value。"
    key="$(trim "${line%%=*}")"
    value="$(trim "${line#*=}")"
    [[ "$key" =~ ^[a-z_]+$ ]] || die "配置错误：${config_file}:${line_number}，配置名无效。"
    case "$key" in
      project_dir|java_home|maven_home|gradle_home|jar_file|env_file)
        [[ -z "$value" ]] || value="$(absolute_from_base "$value" "$base_dir")"
        values["$key"]="$value"
        ;;
      build_tool|java_version|spring_profile|restart_delay_seconds|poll_interval_seconds|stop_timeout_seconds|restart_mode)
        values["$key"]="$value"
        ;;
      maven_arg)
        array_set["$key"]=1
        [[ -z "$value" ]] || maven_args+=("$value")
        ;;
      gradle_arg)
        array_set["$key"]=1
        [[ -z "$value" ]] || gradle_args+=("$value")
        ;;
      java_opt)
        array_set["$key"]=1
        [[ -z "$value" ]] || java_opts+=("$value")
        ;;
      app_arg)
        array_set["$key"]=1
        [[ -z "$value" ]] || application_args+=("$value")
        ;;
      watch)
        array_set["$key"]=1
        [[ -z "$value" ]] || watch_paths+=("$(absolute_from_base "$value" "$base_dir")")
        ;;
      *) die "配置错误：${config_file}:${line_number}，未知配置项：$key" ;;
    esac
  done <"$config_file"
  log "读取配置：$config_file"
}

setting_value() {
  local key="$1" cli="$2" header="$3" environment="$4" fallback="$5"
  first_non_empty "$cli" "${PROJECT_CONFIG[$key]-}" "${GLOBAL_CONFIG[$key]-}" "$header" "$environment" "$fallback"
}

setting_path() {
  local key="$1" cli="$2" header="$3" environment="$4" base="$5"
  local value
  value="$(setting_value "$key" "$cli" "$header" "$environment" "" || true)"
  [[ -z "$value" ]] || absolute_from_base "$value" "$base"
}

choose_array() {
  local key="$1"
  local -n result="$2" cli="$3" project="$4" global="$5" header="$6"
  if (( ${#cli[@]} > 0 )); then
    result=("${cli[@]}")
  elif [[ -n "${PROJECT_ARRAY_SET[$key]-}" ]]; then
    result=("${project[@]}")
  elif [[ -n "${GLOBAL_ARRAY_SET[$key]-}" ]]; then
    result=("${global[@]}")
  else
    result=("${header[@]}")
  fi
}

