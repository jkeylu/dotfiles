#!/usr/bin/env bash

picker_usage() {
  printf '%s\n' \
    'Usage: picker [--multi] [--actions COUNT] [--quit]' \
    '              [--prompt TEXT] [--hint TEXT]' \
    '' \
    'Reads one nonempty item per line and prints the selected item(s).'
}

picker_sanitize_for_display() {
  local value=$1 output_name=${2-} result='' character code index

  for ((index = 0; index < ${#value}; index++)); do
    character=${value:index:1}
    if [[ "$character" == $'\t' ]]; then
      result+='    '
      continue
    fi
    printf -v code '%d' "'$character"
    if ((code < 32 || code == 127)); then
      result+='?'
    else
      result+=$character
    fi
  done
  # Callers rendering a full list can pass an output variable to avoid one
  # command-substitution subshell per item; without it, the helper prints.
  if [[ -n "$output_name" ]]; then
    local -n output_ref=$output_name
    output_ref=$result
  else
    printf '%s' "$result"
  fi
}

picker_decode_escape_sequence() {
  local has_prefix=$1 prefix=$2 has_final=$3 final=$4 output_name=${5-} decoded

  if ((has_prefix == 0)); then
    decoded=cancel
  elif [[ "$prefix" != '[' && "$prefix" != O ]] || ((has_final == 0)); then
    decoded=ignore
  else
    case "$final" in
      A) decoded=up ;;
      B) decoded=down ;;
      *) decoded=ignore ;;
    esac
  fi

  if [[ -n "$output_name" ]]; then
    local -n output_ref=$output_name
    output_ref=$decoded
  else
    printf '%s\n' "$decoded"
  fi
}

picker_parse_args() {
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --multi)
        picker_multi=1
        shift
        ;;
      --actions)
        [[ $# -ge 2 && "$2" =~ ^[0-9]+$ ]] || { picker_usage >&2; return 2; }
        picker_action_count=$((10#$2))
        shift 2
        ;;
      --actions=*)
        local action_count=${1#--actions=}
        [[ "$action_count" =~ ^[0-9]+$ ]] || { picker_usage >&2; return 2; }
        picker_action_count=$((10#$action_count))
        shift
        ;;
      --quit)
        picker_quit_enabled=1
        shift
        ;;
      --prompt)
        [[ $# -ge 2 ]] || { picker_usage >&2; return 2; }
        picker_prompt=$2
        shift 2
        ;;
      --prompt=*)
        picker_prompt=${1#--prompt=}
        shift
        ;;
      --hint)
        [[ $# -ge 2 ]] || { picker_usage >&2; return 2; }
        picker_hint=$2
        picker_hint_set=1
        shift 2
        ;;
      --hint=*)
        picker_hint=${1#--hint=}
        picker_hint_set=1
        shift
        ;;
      -h|--help)
        picker_usage
        return 1
        ;;
      *)
        picker_usage >&2
        return 2
        ;;
    esac
  done
}

picker_read_items() {
  local item display_item

  while IFS= read -r item || [[ -n "$item" ]]; do
    [[ -n "$item" ]] || continue
    picker_items+=("$item")
    picker_sanitize_for_display "$item" display_item
    picker_display_items+=("$display_item")
  done
  [[ ${#picker_items[@]} -gt 0 ]]
}

picker_selectable_window() {
  local offset=$1 last=$2 item_count=$3 action_count=$4
  local -n start_ref=$5 end_ref=$6 total_ref=$7

  total_ref=$((item_count - action_count))
  if ((total_ref <= 0 || last <= action_count)); then
    start_ref=0
    end_ref=0
    return 0
  fi

  # offset and last address every rendered row, while the footer describes
  # only checkbox rows. Translate the visible slice past the fixed actions.
  if ((offset <= action_count)); then
    start_ref=1
  else
    start_ref=$((offset - action_count + 1))
  fi
  end_ref=$((last - action_count))
  ((end_ref <= total_ref)) || end_ref=$total_ref
}

picker_set_default_hint() {
  ((picker_hint_set == 0)) || return 0
  if ((picker_multi)); then
    picker_hint='Up/Down or j/k: move  Space: toggle  Enter: confirm  Esc: cancel'
  else
    picker_hint='Up/Down or j/k: move  Enter: select  Esc: cancel'
  fi
  if ((picker_quit_enabled)); then
    picker_hint+='  q: quit'
  fi
}

picker_restore_terminal() {
  ((picker_terminal_open)) || return 0
  stty "$picker_saved_tty" <&3 || true
  printf '\033[?7h\033[?25h\033[?1049l' >&3
  exec 3>&-
  picker_terminal_open=0
}

picker_exit_on_signal() {
  local status=$1

  trap - EXIT INT TERM
  picker_restore_terminal
  exit "$status"
}

picker_emit_selection() {
  local index

  if ((!picker_multi || picker_cursor < picker_action_count || picker_selected_count == 0)); then
    printf '%s\n' "${picker_items[$picker_cursor]}"
    return 0
  fi
  for index in "${!picker_items[@]}"; do
    if ((picker_selected[index])); then printf '%s\n' "${picker_items[$index]}"; fi
  done
}

picker_draw_menu() {
  local height ignored_width visible last index label mark
  local selectable_start selectable_end selectable_total

  read -r height ignored_width < <(stty size <&3)
  [[ "$height" =~ ^[0-9]+$ ]] || height=24
  # Prompt, hint, their separator, the footer separator, and the footer consume
  # five rows. The footer deliberately has no trailing newline so drawing the
  # last terminal row cannot scroll the alternate screen.
  visible=$((height - 5))
  ((visible > 0)) || visible=1
  if ((picker_cursor < picker_offset)); then
    picker_offset=$picker_cursor
  elif ((picker_cursor >= picker_offset + visible)); then
    picker_offset=$((picker_cursor - visible + 1))
  fi
  last=$((picker_offset + visible))
  ((last < ${#picker_items[@]})) || last=${#picker_items[@]}

  printf '\033[H\033[2J%s\r\n%s\r\n\r\n' "$picker_display_prompt" "$picker_display_hint" >&3
  for ((index = picker_offset; index < last; index++)); do
    label=${picker_display_items[$index]}
    if ((picker_multi && index >= picker_action_count)); then
      mark=' '
      if ((picker_selected[index])); then mark=x; fi
      if ((index == picker_cursor)); then
        printf '\033[7m> [%s] %s\033[0m\r\n' "$mark" "$label" >&3
      else
        printf '  [%s] %s\r\n' "$mark" "$label" >&3
      fi
    elif ((index == picker_cursor)); then
      printf '\033[7m> %s\033[0m\r\n' "$label" >&3
    else
      printf '  %s\r\n' "$label" >&3
    fi
  done

  if ((picker_multi)); then
    picker_selectable_window "$picker_offset" "$last" "${#picker_items[@]}" \
      "$picker_action_count" selectable_start selectable_end selectable_total
    printf '\r\n%d selected  (%d-%d of %d)' \
      "$picker_selected_count" "$selectable_start" "$selectable_end" "$selectable_total" >&3
  else
    printf '\r\n%d of %d' "$((picker_cursor + 1))" "${#picker_items[@]}" >&3
  fi
}

picker_read_action() {
  local key prefix='' final='' has_prefix=0 has_final=0

  if ! IFS= read -r -s -n1 -u 3 key; then
    picker_action=cancel
    return 0
  fi
  case "$key" in
    ' ')
      if ((picker_multi)); then picker_action=toggle; else picker_action=ignore; fi
      ;;
    j) picker_action=down ;;
    k) picker_action=up ;;
    q)
      if ((picker_quit_enabled)); then picker_action=quit; else picker_action=ignore; fi
      ;;
    ''|$'\r'|$'\n') picker_action=accept ;;
    $'\033')
      if IFS= read -r -s -n1 -t 0.1 -u 3 prefix; then
        has_prefix=1
        if [[ "$prefix" == '[' || "$prefix" == O ]]; then
          if IFS= read -r -s -n1 -t 0.1 -u 3 final; then has_final=1; fi
        fi
      fi
      # Terminals encode Alt+key as Esc followed by the key. Only a standalone
      # Esc cancels; Alt chords and unknown/incomplete sequences are ignored.
      picker_decode_escape_sequence "$has_prefix" "$prefix" "$has_final" "$final" picker_action
      ;;
    *) picker_action=ignore ;;
  esac
}

picker_run() {
  local item

  if ! { exec 3<>/dev/tty; } 2>/dev/null; then
    printf 'Error: picker requires a terminal.\n' >&2
    return 2
  fi
  if ! picker_saved_tty="$(stty -g <&3)"; then
    exec 3>&-
    return 2
  fi
  if ! stty -echo -icanon min 1 time 0 <&3; then
    printf 'Error: unable to configure the terminal.\n' >&2
    exec 3>&-
    return 2
  fi

  picker_terminal_open=1
  trap picker_restore_terminal EXIT
  trap 'picker_exit_on_signal 130' INT
  trap 'picker_exit_on_signal 143' TERM
  # Disabling automatic wrapping lets the terminal clip long Unicode labels
  # by display width. This avoids maintaining a partial wcwidth table in Bash.
  printf '\033[?1049h\033[?25l\033[?7l' >&3

  picker_selected=()
  if ((picker_multi)); then
    for item in "${picker_items[@]}"; do picker_selected+=(0); done
  fi
  picker_cursor=0
  picker_offset=0
  picker_selected_count=0

  while :; do
    picker_draw_menu
    picker_read_action
    case "$picker_action" in
      toggle)
        if ((picker_cursor < picker_action_count)); then
          continue
        elif ((picker_selected[picker_cursor])); then
          picker_selected[picker_cursor]=0
          picker_selected_count=$((picker_selected_count - 1))
        else
          picker_selected[picker_cursor]=1
          picker_selected_count=$((picker_selected_count + 1))
        fi
        ;;
      accept)
        trap - EXIT INT TERM
        picker_restore_terminal
        picker_emit_selection
        return 0
        ;;
      cancel)
        trap - EXIT INT TERM
        picker_restore_terminal
        return 130
        ;;
      quit)
        trap - EXIT INT TERM
        picker_restore_terminal
        return 131
        ;;
      up) picker_cursor=$(((picker_cursor + ${#picker_items[@]} - 1) % ${#picker_items[@]})) ;;
      down) picker_cursor=$(((picker_cursor + 1) % ${#picker_items[@]})) ;;
    esac
  done
}

picker_reset_state() {
  picker_prompt=Select
  picker_hint=''
  picker_hint_set=0
  picker_multi=0
  picker_action_count=0
  picker_quit_enabled=0
  picker_items=()
  picker_display_items=()
  picker_display_prompt=''
  picker_display_hint=''
  picker_terminal_open=0
}

picker_main() {
  local parse_status

  picker_reset_state
  picker_parse_args "$@" || {
    parse_status=$?
    [[ $parse_status -eq 1 ]] && return 0
    return "$parse_status"
  }
  picker_set_default_hint
  picker_read_items || return 1
  if ((picker_action_count > 0 && !picker_multi)); then
    printf 'Error: --actions requires --multi.\n' >&2
    return 2
  fi
  ((picker_action_count <= ${#picker_items[@]})) || {
    printf 'Error: --actions exceeds the number of picker items.\n' >&2
    return 2
  }

  picker_sanitize_for_display "$picker_prompt" picker_display_prompt
  picker_sanitize_for_display "$picker_hint" picker_display_hint
  picker_run
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  picker_main "$@"
  exit $?
fi
