#!/usr/bin/env bash

set -euo pipefail

usage() {
  cat <<'EOF'
Usage: codev create <name>
       codev refresh-repos
       codev --help

Create a workspace directory with links to selected Git applications, a
RELEASE directory, and a VS Code workspace file.
Run refresh-repos after adding, removing, or moving applications.

Environment:
  CODEV_CODE_DIR       Directory to search for applications (required)
  CODEV_WORKSPACE_DIR  Workspace parent (defaults to the current directory)
EOF
}

die() {
  printf 'codev: %s\n' "$*" >&2
  exit 1
}

is_windows() {
  case "$(uname -s)" in
    MINGW*|MSYS*|CYGWIN*) return 0 ;;
    *) return 1 ;;
  esac
}

invocation_dir="$(pwd -P)"
script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
index_temp=''
indexed_count=0
destination=''
created_destination=0
created_links=()
release_dir=''
created_release=0
workspace_file=''
workspace_temp=''
created_workspace_file=0

to_absolute_path() {
  local path=$1
  if is_windows; then
    path="$(cygpath -u "$path")" || die "cannot convert path: $1"
  fi
  case "$path" in
    /*) printf '%s\n' "$path" ;;
    *) printf '%s/%s\n' "$invocation_dir" "$path" ;;
  esac
}

resolve_code_dir() {
  local path
  [[ -n "${CODEV_CODE_DIR:-}" ]] || die 'CODEV_CODE_DIR is not set.'
  path="$(to_absolute_path "$CODEV_CODE_DIR")"
  [[ -d "$path" && -r "$path" ]] || die "code directory is not readable: $path"
  cd -P -- "$path" && pwd -P || die "cannot enter code directory: $path"
}

remove_created_link() {
  local link=$1
  if is_windows; then
    MSYS_NO_PATHCONV=1 cmd.exe /c rmdir "$(cygpath -w "$link")" >/dev/null
  else
    rm -- "$link"
  fi
}

cleanup() {
  local status=$? i
  if [[ -n "$index_temp" ]]; then
    rm -f -- "$index_temp" || true
  fi
  if [[ -n "$workspace_temp" ]]; then
    rm -f -- "$workspace_temp" || true
  fi
  if ((status != 0)); then
    if ((created_workspace_file)); then
      rm -f -- "$workspace_file" ||
        printf 'codev: could not remove incomplete workspace file: %s\n' "$workspace_file" >&2
    fi
    for ((i = ${#created_links[@]} - 1; i >= 0; i--)); do
      remove_created_link "${created_links[$i]}" ||
        printf 'codev: could not remove incomplete link: %s\n' "${created_links[$i]}" >&2
    done
    if ((created_release)); then
      rmdir -- "$release_dir" 2>/dev/null ||
        printf 'codev: could not remove incomplete directory: %s\n' "$release_dir" >&2
    fi
    if ((created_destination)); then
      rmdir -- "$destination" 2>/dev/null || true
    fi
  fi
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

link_points_to() {
  local resolved
  [[ -L "$1" ]] || return 1
  resolved="$(cd -P -- "$1" && pwd -P)" || return 1
  [[ "$resolved" == "$2" ]]
}

create_link() {
  local source=$1 link=$2
  if is_windows; then
    MSYS_NO_PATHCONV=1 cmd.exe /c mklink /J \
      "$(cygpath -w "$link")" "$(cygpath -w "$source")" >/dev/null
  else
    ln -s -- "$source" "$link"
  fi
}

json_quote() {
  local value=$1 result='' character escaped code i
  local LC_ALL=C

  for ((i = 0; i < ${#value}; i++)); do
    character=${value:i:1}
    case "$character" in
      '"') result+='\"' ;;
      '\') result+='\\' ;;
      *)
        printf -v code '%d' "'$character"
        if ((code < 32)); then
          printf -v escaped '\\u%04x' "$code"
          result+=$escaped
        else
          result+=$character
        fi
        ;;
    esac
  done
  printf '"%s"' "$result"
}

write_workspace() {
  local index separator quoted
  local -n folders=$1

  workspace_temp="$(mktemp "$destination/.codev-workspace.tmp.XXXXXX")" ||
    die "cannot create workspace file in: $destination"
  {
    printf '{\n  "folders": [\n'
    for index in "${!folders[@]}"; do
      quoted="$(json_quote "${folders[$index]}")"
      separator=,
      ((index + 1 < ${#folders[@]})) || separator=''
      printf '    { "path": %s }%s\n' "$quoted" "$separator"
    done
    printf '  ]\n}\n'
  } >"$workspace_temp" || die "cannot write workspace file: $workspace_file"

  if [[ ! -e "$workspace_file" && ! -L "$workspace_file" ]]; then
    created_workspace_file=1
  fi
  mv -f -- "$workspace_temp" "$workspace_file" ||
    die "cannot replace workspace file: $workspace_file"
  workspace_temp=''
}

confirm_append() {
  local answer
  while :; do
    printf 'codev: %s already exists. Add links? [Y/n] ' "$destination" >&2
    IFS= read -r answer || return 1
    case "$answer" in
      ''|y|Y|yes|YES) return 0 ;;
      n|N|no|NO) return 1 ;;
      *) printf 'codev: enter Y or N.\n' >&2 ;;
    esac
  done
}

scan_repository_dir() {
  local dir=$1 depth=$2 root=$3 relative child

  [[ ! -f "$dir/.codevignore" ]] || return 0
  [[ -r "$dir" && -x "$dir" ]] || die "cannot scan directory: $dir"

  if [[ -d "$dir/.git" && ! -L "$dir/.git" ]]; then
    if [[ "$dir" == "$root" ]]; then
      relative=.
    elif [[ "$root" == / ]]; then
      relative=${dir#/}
    else
      relative=${dir#"$root"/}
    fi
    [[ "$relative" != *$'\n'* && "$relative" != *$'\r'* ]] ||
      die "application path cannot be stored in the index: $relative"
    printf '%s\n' "$relative" >>"$index_temp" || die "cannot write index: $index_temp"
    ((indexed_count += 1))
  fi

  # The code root is depth 0; application directories may be at depths 0-3.
  ((depth < 3)) || return 0
  for child in "${dir%/}"/*/; do
    child=${child%/}
    [[ ! -L "$child" && "${child##*/}" != .git ]] || continue
    scan_repository_dir "$child" "$((depth + 1))" "$root"
  done
}

refresh_index() {
  local code_dir index_file

  code_dir="$(resolve_code_dir)"
  index_file="$code_dir/.codev-repos"
  [[ ! -d "$index_file" ]] || die "index path is a directory: $index_file"
  index_temp="$(mktemp "$code_dir/.codev-repos.tmp.XXXXXX")" ||
    die "cannot create index in: $code_dir"
  indexed_count=0
  shopt -s nullglob dotglob
  scan_repository_dir "$code_dir" 0 "$code_dir"

  [[ ! -d "$index_file" ]] || die "index path became a directory: $index_file"
  mv -f -- "$index_temp" "$index_file" || die "cannot replace index: $index_file"
  index_temp=''
  printf 'Indexed %d applications: %s\n' "$indexed_count" "$index_file"
}

create_workspace() {
  local name=$1 code_dir workspace_dir index_file app relative selection status
  local label index found source link key previous_key existing_destination=0
  local entry entry_name entry_key duplicate release_key workspace_key
  local nullglob_was_set=0 dotglob_was_set=0
  local -a labels=() applications=() chosen_apps=() chosen_names=() chosen_keys=()
  local -a workspace_names=() workspace_keys=()

  [[ -n "$name" && "$name" != . && "$name" != .. &&
     "$name" != */* && "$name" != *\\* ]] || die 'name must be a single directory name.'
  code_dir="$(resolve_code_dir)"

  workspace_dir="$(to_absolute_path "${CODEV_WORKSPACE_DIR:-$invocation_dir}")"
  destination="${workspace_dir%/}/$name"
  release_dir="$destination/RELEASE"
  workspace_file="$destination/$name.code-workspace"

  index_file="$code_dir/.codev-repos"
  [[ -f "$index_file" && -r "$index_file" ]] ||
    die "repository index is missing or unreadable: $index_file; run 'codev refresh-repos' first."
  while IFS= read -r relative || [[ -n "$relative" ]]; do
    case "$relative" in
      .) app=$code_dir ;;
      ''|/*|..|../*|*/..|*/../*|./*|*/.|*/./*|*//*|*$'\r'*)
        die "invalid application path in index: $relative" ;;
      *) app="$code_dir/$relative" ;;
    esac
    if is_windows && [[ "$relative" == *\\* ]]; then
      die "invalid application path in index: $relative"
    fi
    labels+=("$relative")
    applications+=("$app")
  done <"$index_file"
  [[ ${#labels[@]} -gt 0 ]] || die "no Git applications in index; run 'codev refresh-repos' after adding repositories."

  if selection="$(printf '%s\n' "${labels[@]}" | "$script_dir/picker" --multi --prompt 'Applications')"; then
    :
  else
    status=$?
    [[ $status -eq 1 || $status -eq 130 ]] && return 0
    die "picker failed (exit $status)."
  fi
  [[ -n "$selection" ]] || return 0

  while IFS= read -r label; do
    found=0
    for index in "${!labels[@]}"; do
      if [[ "$label" == "${labels[$index]}" ]]; then
        source=${applications[$index]}
        found=1
        break
      fi
    done
    ((found)) || die "picker returned an unknown application: $label"
    [[ -d "$source" && -d "$source/.git" ]] ||
      die "application disappeared: $source; run 'codev refresh-repos'."
    source="$(cd -P -- "$source" && pwd -P)" || die "cannot enter application: $source"
    [[ "$code_dir" == / || "$source" == "$code_dir" || "$source" == "$code_dir/"* ]] ||
      die "indexed application is outside code directory: $source"
    [[ "$source" != / ]] || die 'the filesystem root cannot be linked as an application.'
    chosen_apps+=("$source")
    chosen_names+=("${source##*/}")
  done <<<"$selection"

  for index in "${!chosen_names[@]}"; do
    key=${chosen_names[$index]}
    if is_windows; then key=${key,,}; fi
    release_key=RELEASE
    workspace_key="$name.code-workspace"
    if is_windows; then
      release_key=${release_key,,}
      workspace_key=${workspace_key,,}
    fi
    [[ "$key" != "$release_key" && "$key" != "$workspace_key" ]] ||
      die "selected application uses a reserved workspace name: ${chosen_names[$index]}"
    for previous_key in "${chosen_keys[@]}"; do
      [[ "$key" != "$previous_key" ]] || die "selected applications share the link name: ${chosen_names[$index]}"
    done
    chosen_keys+=("$key")
  done

  if [[ -e "$destination" || -L "$destination" ]]; then
    [[ -d "$destination" && ! -L "$destination" ]] || die "destination is not a regular directory: $destination"
    confirm_append || return 0
    existing_destination=1

    if [[ -e "$release_dir" || -L "$release_dir" ]]; then
      [[ -d "$release_dir" && ! -L "$release_dir" ]] ||
        die "RELEASE path is not a regular directory: $release_dir"
    fi
    if [[ -e "$workspace_file" || -L "$workspace_file" ]]; then
      [[ -f "$workspace_file" && ! -L "$workspace_file" ]] ||
        die "workspace path is not a regular file: $workspace_file"
    fi
  fi

  for index in "${!chosen_apps[@]}"; do
    link="$destination/${chosen_names[$index]}"
    if [[ -e "$link" || -L "$link" ]]; then
      link_points_to "$link" "${chosen_apps[$index]}" || die "link name is occupied: $link"
    fi
  done

  if ((existing_destination)); then
    shopt -q nullglob && nullglob_was_set=1
    shopt -q dotglob && dotglob_was_set=1
    shopt -s nullglob dotglob
    for entry in "$destination"/*; do
      [[ -L "$entry" && -d "$entry" ]] || continue
      entry_name=${entry##*/}
      entry_key=$entry_name
      if is_windows; then entry_key=${entry_key,,}; fi
      workspace_names+=("$entry_name")
      workspace_keys+=("$entry_key")
    done
    ((nullglob_was_set)) || shopt -u nullglob
    ((dotglob_was_set)) || shopt -u dotglob
  fi

  for index in "${!chosen_names[@]}"; do
    key=${chosen_names[$index]}
    if is_windows; then key=${key,,}; fi
    duplicate=0
    for previous_key in "${workspace_keys[@]}"; do
      if [[ "$key" == "$previous_key" ]]; then
        duplicate=1
        break
      fi
    done
    if ((!duplicate)); then
      workspace_names+=("${chosen_names[$index]}")
      workspace_keys+=("$key")
    fi
  done
  workspace_names+=(RELEASE)

  mkdir -p -- "$workspace_dir" || die "cannot create workspace directory: $workspace_dir"
  if ((existing_destination)); then
    [[ -d "$destination" && ! -L "$destination" ]] || die "destination changed: $destination"
  else
    mkdir -- "$destination" || die "cannot create destination: $destination"
    created_destination=1
  fi

  if [[ -e "$release_dir" || -L "$release_dir" ]]; then
    [[ -d "$release_dir" && ! -L "$release_dir" ]] ||
      die "RELEASE path changed: $release_dir"
  else
    mkdir -- "$release_dir" || die "cannot create RELEASE directory: $release_dir"
    created_release=1
  fi

  for index in "${!chosen_apps[@]}"; do
    link="$destination/${chosen_names[$index]}"
    if [[ -e "$link" || -L "$link" ]]; then
      link_points_to "$link" "${chosen_apps[$index]}" || die "link name became occupied: $link"
      continue
    fi
    create_link "${chosen_apps[$index]}" "$link" || die "could not create link: $link"
    created_links+=("$link")
    printf '%s -> %s\n' "$link" "${chosen_apps[$index]}"
  done
  write_workspace workspace_names
}

case "${1:-}" in
  create)
    [[ $# -eq 2 ]] || { usage >&2; exit 2; }
    create_workspace "$2"
    ;;
  refresh-repos)
    [[ $# -eq 1 ]] || { usage >&2; exit 2; }
    refresh_index
    ;;
  -h|--help|help)
    [[ $# -eq 1 ]] || { usage >&2; exit 2; }
    usage
    ;;
  *)
    usage >&2
    exit 2
    ;;
esac
