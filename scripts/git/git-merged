#!/usr/bin/env bash

clean=0
remote_mode=0
comparison_remote=origin
branch=
branches=()
selected_branches=()
local_oids=()
remotes=()
remote_refs=()
remote_oids=()

usage() {
  printf 'Usage: git merged [--clean] [-r|--remote [remote]] [branch]\n' >&2
  exit 1
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --clean)
      [[ "$clean" -eq 0 ]] || usage
      clean=1
      shift
      ;;
    -r|--remote)
      [[ "$remote_mode" -eq 0 ]] || usage
      remote_mode=1
      shift
      if [[ $# -gt 0 && "$1" != -* ]]; then
        comparison_remote=$1
        shift
      fi
      ;;
    -*) usage ;;
    *)
      [[ -z "$branch" ]] || usage
      branch=$1
      shift
      ;;
  esac
done
branch="${branch:-HEAD}"

if ! git rev-parse --verify --quiet "${branch}^{commit}" >/dev/null; then
  printf "Error: branch '%s' does not exist\n" "$branch" >&2
  exit 1
fi

target_ref="$(git rev-parse --symbolic-full-name "$branch")" || exit 1

# The helpers below use the snapshot arrays local to compare_remote_branches.
remote_group_unchanged() {
  local key=$1 ref current_oid current_target current_target_ref resolved_ref worktrees
  current_target="$(git rev-parse --verify --quiet "${branch}^{commit}")" || return 1
  current_target_ref="$(git rev-parse --symbolic-full-name "$branch")" || return 1
  if [[ -n "$current_target_ref" ]] && resolved_ref="$(git symbolic-ref --quiet "$current_target_ref")"; then
    current_target_ref=$resolved_ref
  fi
  if [[ "$current_target" != "$target_oid" || "$current_target_ref" != "$target_ref" ]]; then
    printf "Error: comparison target '%s' changed; run git merged again.\n" "$branch" >&2
    return 1
  fi
  worktrees="$(git worktree list --porcelain)" || return 1
  while IFS= read -r ref; do
    [[ -n "$ref" ]] || continue
    current_oid="$(git rev-parse --verify --quiet "$ref")" || current_oid=
    if [[ "$current_oid" != "${snapshot_oids[$ref]}" ]] ||
       ! git merge-base --is-ancestor "$current_oid" "$target_oid"; then
      printf "Error: '%s' changed or is no longer merged; run git merged again.\n" "$ref" >&2
      return 1
    fi
    if [[ "$ref" == refs/heads/* && $'\n'"$worktrees"$'\n' == *$'\n'"branch $ref"$'\n'* ]]; then
      printf "Error: branch '%s' is checked out in a worktree.\n" "${ref#refs/heads/}" >&2
      return 1
    fi
  done <<< "${group_members[$key]}"
  # Also detect a previously absent counterpart appearing during selection.
  if [[ -z "${group_remote[$key]:-}" ]] &&
     git show-ref --verify --quiet "refs/remotes/$comparison_remote/$key"; then
    printf "Error: remote-tracking branch '%s/%s' appeared; run git merged again.\n" "$comparison_remote" "$key" >&2
    return 1
  fi
}

remote_server_unchanged() {
  local key=$1 remote_line ref oid actual_oid= expected_oid=
  ref="${group_remote[$key]:-}"
  [[ -z "$ref" ]] || expected_oid="${snapshot_oids[$ref]}"
  remote_line="$(git ls-remote --heads "$comparison_remote" "refs/heads/$key")" || return 1
  # Match the full ref, since ls-remote patterns can also match ref suffixes.
  while IFS=$'\t' read -r oid ref; do
    [[ "$ref" != "refs/heads/$key" ]] || actual_oid=$oid
  done <<< "$remote_line"
  if [[ "$actual_oid" != "$expected_oid" ]]; then
    printf "Error: server branch '%s/%s' differs from the remote-tracking snapshot. Run git fetch %q --prune and retry.\n" \
      "$comparison_remote" "$key" "$comparison_remote" >&2
    return 1
  fi
}

compare_remote_branches() {
  local configured_remotes remote_found=0 candidate ref oid symref upstream_remote upstream_ref
  local refs key name target_oid worktrees status merged_state local_details remote_details relation
  local all_merged protected checked_out reason counts left right details label selected found index answer
  local selection select_status current_oid
  local target_ref=$target_ref
  local -a group_keys=() choices=() choice_keys=() selected_groups=()
  local -A snapshot_oids=() group_members=() group_remote=() group_reports=() selected_keys=()

  configured_remotes="$(git remote)" || return 1
  while IFS= read -r candidate; do
    [[ "$candidate" != "$comparison_remote" ]] || remote_found=1
  done <<< "$configured_remotes"
  if [[ "$remote_found" -eq 0 ]]; then
    printf "Error: remote '%s' does not exist.\n" "$comparison_remote" >&2
    return 1
  fi
  printf 'Remote-tracking data may be outdated. Run git fetch %q --prune to update it.\n' "$comparison_remote" >&2
  target_oid="$(git rev-parse --verify "${branch}^{commit}")" || return 1
  if [[ -n "$target_ref" ]] && symref="$(git symbolic-ref --quiet "$target_ref")"; then
    target_ref=$symref
  fi
  worktrees="$(git worktree list --porcelain)" || return 1

  refs="$(git for-each-ref --format='%(refname)%09%(objectname)%09%(symref)' "refs/remotes/$comparison_remote/")" || return 1
  while IFS=$'\t' read -r ref oid symref; do
    [[ -n "$ref" && -z "$symref" ]] || continue
    key="${ref#refs/remotes/$comparison_remote/}"
    group_keys+=("$key")
    group_remote[$key]=$ref
    group_members[$key]=$ref
    snapshot_oids[$ref]=$oid
  done <<< "$refs"

  refs="$(git for-each-ref --format='%(refname)%09%(objectname)%09%(upstream:remotename)%09%(upstream:remoteref)' refs/heads/)" || return 1
  while IFS=$'\t' read -r ref oid upstream_remote upstream_ref; do
    [[ -n "$ref" ]] || continue
    key="${ref#refs/heads/}"
    if [[ "$upstream_remote" == "$comparison_remote" && "$upstream_ref" == refs/heads/* ]]; then
      key="${upstream_ref#refs/heads/}"
    fi
    if [[ -z "${group_members[$key]:-}" ]]; then
      group_keys+=("$key")
      group_members[$key]=$ref
    else
      group_members[$key]+=$'\n'"$ref"
    fi
    snapshot_oids[$ref]=$oid
  done <<< "$refs"

  # Query output stays on stdout; the clean report belongs with the prompts.
  if [[ "$clean" -eq 1 ]]; then
    exec 3>&2
  else
    exec 3>&1
  fi
  printf 'Target: %s (%s); remote: %s\n' "$branch" "${target_oid:0:12}" "$comparison_remote" >&3
  printf 'GROUP\tLOCAL\tREMOTE\tRELATION\tCLEANUP\n' >&3
  for key in "${group_keys[@]}"; do
    local_details= remote_details= relation= details=
    all_merged=1 protected=0 checked_out=0
    while IFS= read -r ref; do
      oid="${snapshot_oids[$ref]}"
      git merge-base --is-ancestor "$oid" "$target_oid"
      status=$?
      case "$status" in
        0) merged_state=merged ;;
        1) merged_state=unmerged; all_merged=0 ;;
        *) return "$status" ;;
      esac
      [[ "$ref" != "$target_ref" ]] || protected=1
      if [[ "$ref" == refs/heads/* ]]; then
        name="${ref#refs/heads/}"
        local_details+="${local_details:+; }$name ($merged_state, ${oid:0:12})"
        if [[ $'\n'"$worktrees"$'\n' == *$'\n'"branch $ref"$'\n'* ]]; then
          checked_out=1
        fi
        candidate="${group_remote[$key]:-}"
        if [[ -n "$candidate" && "$oid" != "${snapshot_oids[$candidate]}" ]]; then
          counts="$(git rev-list --left-right --count "$oid...${snapshot_oids[$candidate]}")" || return 1
          read -r left right <<< "$counts"
          details+="${details:+; }$name: local-only=$left remote-only=$right"
        fi
      else
        remote_details="$comparison_remote/$key ($merged_state, ${oid:0:12})"
      fi
    done <<< "${group_members[$key]}"
    if [[ -z "$local_details" ]]; then
      relation='remote only'
    elif [[ -z "$remote_details" ]]; then
      relation='local only'
    elif [[ -n "$details" ]]; then
      relation="different ($details)"
    else
      relation=same
    fi
    reason=
    [[ "$protected" -eq 0 ]] || reason='comparison target'
    [[ "$checked_out" -eq 0 ]] || reason+="${reason:+; }checked out in worktree"
    [[ "$all_merged" -eq 1 ]] || reason+="${reason:+; }unmerged member"
    printf -v label '%s\tlocal: %s | remote: %s | %s' "$key" "${local_details:-none}" "${remote_details:-none}" "$relation"
    group_reports[$key]=$label
    if [[ -z "$reason" ]]; then
      choices+=("$label")
      choice_keys+=("$key")
      reason=eligible
    else
      reason="skip: $reason"
    fi
    printf '%s\t%s\t%s\t%s\t%s\n' "$key" "${local_details:-none}" "${remote_details:-none}" "$relation" "$reason" >&3
  done
  exec 3>&-
  [[ "$clean" -eq 1 ]] || return 0
  if [[ "${#choices[@]}" -eq 0 ]]; then
    printf 'No merged branch groups eligible for cleanup.\n' >&2
    return 0
  fi
  selection="$(printf '%s\n' "${choices[@]}" | picker --multi --prompt 'Merged branch groups')"
  select_status=$?
  case "$select_status" in
    1|130) return 0 ;;
    0) ;;
    *) printf 'Error: picker failed.\n' >&2; return "$select_status" ;;
  esac
  [[ -n "$selection" ]] || return 0
  while IFS= read -r selected; do
    found=0
    for index in "${!choices[@]}"; do
      if [[ "$selected" == "${choices[$index]}" ]]; then
        key="${choice_keys[$index]}"
        found=1
        break
      fi
    done
    if [[ "$found" -eq 0 || -n "${selected_keys[$key]:-}" ]]; then
      printf 'Error: invalid or duplicate branch group selection.\n' >&2
      return 1
    fi
    selected_keys[$key]=1
    selected_groups+=("$key")
  done <<< "$selection"

  for key in "${selected_groups[@]}"; do
    remote_group_unchanged "$key" || return 1
    remote_server_unchanged "$key" || return 1
  done
  printf 'Delete these merged branch groups (all listed local and remote branches)?\n' >&2
  for key in "${selected_groups[@]}"; do
    printf '  %s\n' "${group_reports[$key]}" >&2
  done
  printf 'Confirm deletion [y/N]: ' >&2
  IFS= read -r answer || return 0
  case "$answer" in
    y|Y|yes|YES) ;;
    *) return 0 ;;
  esac
  # Recheck the entire selection before the first mutation.
  for key in "${selected_groups[@]}"; do
    remote_group_unchanged "$key" || return 1
    remote_server_unchanged "$key" || return 1
  done
  for key in "${selected_groups[@]}"; do
    remote_group_unchanged "$key" || return 1
    ref="${group_remote[$key]:-}"
    if [[ -n "$ref" ]]; then
      git push --force-with-lease="refs/heads/$key:${snapshot_oids[$ref]}" \
        "$comparison_remote" ":refs/heads/$key" || return 1
    fi
    while IFS= read -r ref; do
      [[ "$ref" == refs/heads/* ]] || continue
      current_oid="$(git rev-parse --verify --quiet "$ref")" || return 1
      if [[ "$current_oid" != "${snapshot_oids[$ref]}" ]]; then
        printf "Error: branch '%s' changed before local deletion.\n" "${ref#refs/heads/}" >&2
        return 1
      fi
      git branch -D -- "${ref#refs/heads/}" || return 1
    done <<< "${group_members[$key]}"
  done
  return 0
}

if [[ "$remote_mode" -eq 1 ]]; then
  compare_remote_branches
  exit $?
fi

merged_refs="$(git for-each-ref --merged="$branch" --format='%(refname)' refs/heads/)" || exit 1
while IFS= read -r ref; do
  [[ -z "$ref" || "$ref" == "$target_ref" ]] && continue
  branches+=("${ref#refs/heads/}")
done <<< "$merged_refs"

if [[ "$clean" -eq 0 ]]; then
  if [[ "${#branches[@]}" -gt 0 ]]; then
    printf '%s\n' "${branches[@]}"
  fi
  exit 0
fi

if [[ "${#branches[@]}" -eq 0 ]]; then
  printf 'No merged branches found.\n' >&2
  exit 0
fi
selection="$(printf '%s\n' "${branches[@]}" | picker --multi --prompt 'Merged branches')"
select_status=$?
if [[ "$select_status" -eq 1 || "$select_status" -eq 130 ]]; then
  exit 0
fi
if [[ "$select_status" -ne 0 ]]; then
  printf 'Error: picker failed.\n' >&2
  exit "$select_status"
fi
[[ -n "$selection" ]] || exit 0

while IFS= read -r selected; do
  found=0
  for name in "${branches[@]}"; do
    if [[ "$selected" == "$name" ]]; then
      found=1
      break
    fi
  done
  if [[ "$found" -ne 1 ]]; then
    printf "Error: invalid branch selection '%s'.\n" "$selected" >&2
    exit 1
  fi
  for name in "${selected_branches[@]}"; do
    if [[ "$selected" == "$name" ]]; then
      printf "Error: duplicate branch selection '%s'.\n" "$selected" >&2
      exit 1
    fi
  done
  selected_branches+=("$selected")
done <<< "$selection"

# Resolve every deletion before asking for confirmation. A branch without an
# upstream uses origin (or the only configured remote) with the same name.
for name in "${selected_branches[@]}"; do
  ref="refs/heads/$name"
  local_oid="$(git rev-parse --verify --quiet "$ref")" || exit 1
  if ! git merge-base --is-ancestor "$ref" "$branch"; then
    printf "Error: branch '%s' is no longer merged into '%s'.\n" "$name" "$branch" >&2
    exit 1
  fi
  while IFS= read -r worktree_branch; do
    if [[ "$worktree_branch" == "branch $ref" ]]; then
      printf "Error: branch '%s' is checked out in a worktree.\n" "$name" >&2
      exit 1
    fi
  done < <(git worktree list --porcelain)

  info="$(git for-each-ref --format='%(upstream:remotename)%09%(upstream:remoteref)' "$ref")" || exit 1
  remote="${info%%$'\t'*}"
  remote_ref="${info#*$'\t'}"
  if [[ -z "$remote" || "$remote" == . || "$remote_ref" != refs/heads/* ]]; then
    remote=
    remote_ref=
    if git remote | grep -Fxq origin; then
      remote=origin
    else
      info="$(git remote)" || exit 1
      if [[ -n "$info" && "$info" != *$'\n'* ]]; then
        remote="$info"
      fi
    fi
    [[ -z "$remote" ]] || remote_ref="refs/heads/$name"
  fi

  remote_oid=
  if [[ -n "$remote" ]]; then
    remote_line="$(git ls-remote --heads "$remote" "$remote_ref")" || exit 1
    if [[ -n "$remote_line" ]]; then
      remote_oid="${remote_line%%$'\t'*}"
      if [[ "$remote_oid" != "$local_oid" ]]; then
        printf "Error: remote branch '%s/%s' differs from local '%s'; fetch and review it first.\n" \
          "$remote" "${remote_ref#refs/heads/}" "$name" >&2
        exit 1
      fi
    fi
  fi
  local_oids+=("$local_oid")
  remotes+=("$remote")
  remote_refs+=("$remote_ref")
  remote_oids+=("$remote_oid")
done

printf 'Delete these merged branches?\n' >&2
for i in "${!selected_branches[@]}"; do
  printf '  local: %s\n' "${selected_branches[$i]}" >&2
  if [[ -n "${remote_oids[$i]}" ]]; then
    printf '  remote: %s/%s\n' "${remotes[$i]}" "${remote_refs[$i]#refs/heads/}" >&2
  else
    printf '  remote: none\n' >&2
  fi
done
printf 'Confirm deletion [y/N]: ' >&2
IFS= read -r answer || exit 0
case "$answer" in
  y|Y|yes|YES) ;;
  *) exit 0 ;;
esac

for i in "${!selected_branches[@]}"; do
  name="${selected_branches[$i]}"
  ref="refs/heads/$name"
  local_oid="$(git rev-parse --verify --quiet "$ref")" || exit 1
  if [[ "$local_oid" != "${local_oids[$i]}" ]] || ! git merge-base --is-ancestor "$ref" "$branch"; then
    printf "Error: branch '%s' changed or is no longer merged into '%s'.\n" "$name" "$branch" >&2
    exit 1
  fi
  if [[ -n "${remote_oids[$i]}" ]]; then
    git push --force-with-lease="${remote_refs[$i]}:${remote_oids[$i]}" \
      "${remotes[$i]}" ":${remote_refs[$i]}" || exit 1
  fi
  local_oid="$(git rev-parse --verify --quiet "$ref")" || exit 1
  if [[ "$local_oid" != "${local_oids[$i]}" ]]; then
    printf "Error: branch '%s' changed before local deletion.\n" "$name" >&2
    exit 1
  fi
  git branch -D -- "$name" || exit 1
done
